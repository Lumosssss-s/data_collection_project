# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
/dist/
/build/

# 生成的缓存数据（可重新生成）
medical_rag/data/kg_cache/

# 运行产物与原始数据（可重建/体积大，不入库）
medical_rag/data/raw/
medical_rag/data/intermediate/
medical_rag/data/reports/
medical_rag/eval_data/results/

# 清洗后数据（G3 14 目录）随仓库交付，供 ingest.py 入库；
# 文献层（PubMed 摘要）因版权原因不随公开仓库分发，克隆后该层为空，问答仍可用。
medical_rag/data/clean/literature/

# 生成的图表（可重新生成）
medical_rag/eval_data/charts/

# 本地模型文件（体积约 4.28GB，不入库；仅锚定项目根目录的 models/，
# 避免误伤 medical_rag/models/ Python 包）。下载方式见 models/README.md
/models/*

# 文档：仅 README.md 入库，其余 Markdown 一律本地留存（不入库、不推送）
# 注：本规则对「已跟踪」文件不生效，历史已入库的 .md 需 git rm --cached 取消跟踪
*.md
!/README.md
!/models/README.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# 环境（含密钥，禁止入库）
.env
*.env.local
# docker.env 内含真实 DeepSeek API Key，务必忽略
docker.env

# 备份文件
*.bak
*.bak-*

# 小程序工程（miniapp/，Taro）：依赖与预览运行态不入库
miniapp/node_modules/
miniapp/.pai/
# SWC 编译缓存（可再生，体积约 2.7MB）
miniapp/.swc/

# 小程序预览运行态（可能在工作目录根生成）
.pai/

# 运行日志与调试截图（本地产物，不入库）
logs/
*.log

# 数据备份（写回前的带时间戳快照，可再生，不入库）
medical_rag/data/backups/

# 操作系统
Thumbs.db
.DS_Store