{
  "type": "drug",
  "dir": "drug_labels",
  "id_field": "drug_id",
  "id_pattern": "^DRUG-([A-Z]+-){1,2}\\d{3,4}$",
  "g6_required": true,
  "required": ["drug_id", "generic_name", "atc_code", "approval_no", "indications", "dosage", "contraindications", "adverse_reactions"],
  "nullable_required": ["approval_no"],
  "nullable_required_note": "approval_no 对 FDA/DailyMed 来源豁免必填（无国药准字，G8 以 null 表达）；NMPA 来源仍须真实批准文号",
  "properties": {
    "drug_id": {"type": "string"},
    "generic_name": {"type": "string"},
    "brand_names": {"type": "array", "nullable": true},
    "aliases_zh": {"type": "array", "items": {"type": "string"}, "nullable": true,
                   "note": "中文通用名别名，2026-11-02 新增；来源为仓内 terminology_cancer.json / semantic_cache.py / entity_disambiguation_service.py / fetch_dailymed_labels.py 及 NMPA 官网与厂商官方说明书（逐条来源见当日交付报告），无来源不填"},
    "atc_code": {"type": "string", "pattern": "^[ABDGHJLMNPSV][0-9]{2}[A-Z]{2}[0-9]{2}[A-Z]{0,2}$|^[ABDGHJLMNPSV][0-9]{2}[A-Z]{2}$"},
    "approval_no": {"type": "string", "nullable": true},
    "indications": {"type": "array", "items": {"type": "string"}},
    "dosage": {"type": "object"},
    "contraindications": {"type": "array", "items": {"type": "string"}},
    "adverse_reactions": {"type": "array", "items": {"type": "object"}},
    "interactions": {"type": "array", "nullable": true},
    "cancer_type": {"type": "string", "enum": ["lung", "breast", "colorectal", "gastric", "thyroid", "liver"], "nullable": true,
                    "note": "兼容字段 = cancer_types[0]；多癌种一药单记录以 cancer_types 为准"},
    "cancer_types": {"type": "array", "items": {"type": "string",
                     "enum": ["lung", "breast", "colorectal", "gastric", "thyroid", "liver"]},
                     "nullable": true, "note": "2026-11-02 起新增；同一份说明书只保留一条记录"},
    "indication_note": {"type": "string", "nullable": true,
                        "note": "适应证限定说明（如仅联合方案、无单药适应证），2026-11-02 起新增；无限定时不填"},
    "duplicate_of": {"type": "string", "nullable": true,
                     "note": "克隆视图记录指向主记录 drug_id；入库时应跳过含此字段的记录"},
    "duplicate_reason": {"type": "string", "nullable": true},
    "boxed_warning": {"type": "array", "nullable": true,
                      "note": "34066-1 黑框警告，独立存放不混入 warnings"},
    "warnings": {"type": "array", "nullable": true,
                 "note": "43685-7/34071-1 顶层编号子节成条，含 code/title/text/char_len/溯源字段"},
    "dosage_adjustment": {"type": "object", "nullable": true,
                          "note": "renal/hepatic/toxicity_modification 三子字段，未定位带 located=false+reason"},
    "safety_extraction_meta": {"type": "object", "nullable": true},
    "fetched_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "nullable": true},
    "license": {"type": "string", "nullable": true},
    "license_evidence": {"type": "string", "nullable": true},
    "publish_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "nullable": true},
    "doc_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "review_status": {"type": "string", "enum": ["draft", "reviewed", "approved"], "nullable": true}
  },
  "g6_fields": ["source_name", "source_version", "source_section", "source_file", "updated_at"],
  "g6_date_fields": ["updated_at"]
}
