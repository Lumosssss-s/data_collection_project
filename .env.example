# 环境变量模板：复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，禁止入库）
# 用法：cp .env.example .env
# 说明：下方键名覆盖 docker-compose.yml 中以 ${...} 注入 backend 的全部变量。
#       其中带默认值的变量可留空（compose 会回退到默认值），敏感项必须填写。

# ===== 必填：密钥与口令（禁止提交真实值） =====
MEDICAL_LLM_API_KEY=CHANGE_ME
MEDICAL_DEEPSEEK_API_KEY=CHANGE_ME
MEDICAL_ES_PASSWORD=CHANGE_ME
MEDICAL_ADMIN_TOKEN=CHANGE_ME

# ===== 模型目录（相对本文件所在目录，即仓库根） =====
# 需在此目录下放置 bge-m3/ 与 bge-reranker-v2-m3/ 两个模型子目录（合计约 6.41GB）
MEDICAL_MODELS_DIR=./models

# ===== 基础设施地址（默认与 compose 内的服务名一致，一般无需修改） =====
MEDICAL_REDIS_URL=redis://redis:6379/0

# ===== 开关（默认值与 compose 内的 :- 默认一致） =====
MEDICAL_SEMANTIC_CACHE_ENABLED=true
MEDICAL_RAG_CHAIN_ENABLED=true
MEDICAL_ENTITY_ALIGN_ENABLED=true
MEDICAL_ENTITY_ALIGN_INTRA_BATCH=true

# ===== 数值参数 =====
MEDICAL_ENTITY_ALIGN_THRESHOLD=0.95
MEDICAL_TORCH_NUM_THREADS=8
MEDICAL_RERANKER_BATCH_SIZE=8
MEDICAL_RERANKER_WINDOW=20

# ===== H5 预览服务 Basic Auth（scripts/h5_preview.py 启动必需，缺任一项则拒绝启动） =====
MEDICAL_H5_AUTH_USER=CHANGE_ME
MEDICAL_H5_AUTH_PASS=CHANGE_ME
